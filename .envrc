use flake

# Build output location. Honour CARGO_TARGET_DIR when the environment sets it,
# matching the flake's shellHook, and fall back to the shared sw1nn cargo target
# under the current user's home rather than a hardcoded one.
_target_dir="${CARGO_TARGET_DIR:-$HOME/.cache/cargo/sw1nn/cargo_target}/debug"

# Set plugin path to our build output
export VERANDAH_PLUGIN_PATH="$_target_dir"

# Add the control binary to PATH
PATH_add "$_target_dir"

# Useful for debugging
export RUST_BACKTRACE=1
